u64 syscall1(u64 number, u64 arg1) {
  u64 ret;
  asm volatile("syscall"
               : "=a"(ret)
               : "a"(number), "D"(arg1)
               : "rcx", "r11", "memory");
  return ret;
}

u64 syscall3(u64 number, u64 arg1, u64 arg2, u64 arg3) {
  u64 ret;
  asm volatile("syscall"
               : "=a"(ret)
               : "a"(number), "D"(arg1), "S"(arg2), "d"(arg3)
               : "rcx", "r11", "memory");
  return ret;
}

void _start() { 
    syscall3(1, 0, (u64)"nya\n", 4);
    syscall1(60, 0); 
}

